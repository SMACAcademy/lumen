{
  "name": "lumen",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "repository": "github:SMACAcademy/lumen",
  "description": "Lumen: maths, physics and chemistry you can touch, for class 6 to 12. Every concept is a live simulation.",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @ise/web dev",
    "build": "pnpm --filter @ise/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
